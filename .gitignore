## .NET / ASP.NET Core .gitignore

# Build outputs
bin/
obj/
**/.tmp/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# MSBuild
*.log
*.binlog

# .NET Core
project.assets.json
project.nuget.cache
*.csproj.nuget.*
.dotnet-cli/
.dotnet-cli */
.tmp-build/
.tmp_pypdf/

# ASP.NET Core secrets / environment-specific
appsettings.Development.json
appsettings.*.local.json
secrets.json

# Coverage
TestResults/
coverage/
*.coverage
*.coveragexml

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Publish output
publish/

# Uploaded user content (student photos vb.) — disk storage, repoya girmez
App_Data/
**/App_Data/

# Node / React (SIS.Web)
node_modules/
SIS.Web/dist/
SIS.Web/dist-ssr/
*.local

# Vite dev server cache (auto-generated; nerede oluşursa oluşsun)
**/.vite/

# Claude Code settings (contains local session data)
.claude/
CLAUDE.md

# Superpowers planning docs (dev-only, not part of project)
docs/superpowers/

# Database backup files
scripts/*.backup
scripts/*.dump
backup_*.sql

# Environment files
.env
.env.*
!.env.example

# Local analysis reports (codemap-diff, audit reports vb.)
.reports/

*.exe

OWASP_Application_Security_Verification_Standard_5.0.0_tr.pdf
